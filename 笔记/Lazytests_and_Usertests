1. 给sbrk添加处理参数为负数的情况，就是将growproc()中n<0的情况拿出来，注意n不能大于p->sz
uint64
sys_sbrk(void)
{
  int addr;
  int n;

  if(argint(0, &n) < 0)
    return -1;
  
  struct proc* p = myproc();
  addr = p->sz;
  if (n < 0)
  {
    if (p->sz + n < 0) return -1;
    else uvmdealloc(p->pagetable, p->sz, p->sz + n);
  }
  p->sz += n;
  // if(growproc(n) < 0)
  //   return -1;
  return addr;
}
